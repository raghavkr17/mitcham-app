# --- Postgres ---
# Use a hosted Postgres (Supabase / Neon / Railway / Render) and its pooler URL.
# Local example: postgres://postgres:postgres@localhost:5432/mitcham
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
# Create an OAuth 2.0 Client of type "Web application".
# Authorized redirect URI: ${API origin}/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- JWT signing secret (32+ random bytes) ---
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string

# --- Express session (used only for passport's OAuth state parameter) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-me-with-a-different-random-string

# --- Frontend origin (where the SPA lives) ---
# For local dev, run `npx serve frontend -l 5500` then use:
FRONTEND_ORIGIN=http://localhost:5500

# --- Server port ---
PORT=3001

# --- Platform admin emails (comma-separated) ---
# Any user who signs in with one of these emails becomes a platform_admin —
# able to approve/reject/suspend vendors in the marketplace.
PLATFORM_ADMIN_EMAILS=you@example.com
